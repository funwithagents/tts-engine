**/__pycache__/
*.pyc
*.pyo
*.pyd
config.json
.DS_Store

# Latency benchmark (benchmarks/): results/ (merged, described) is
# committed; runs/ (every run as it happened, with worker logs), hand-placed
# models and the stdout logs of unattended passes are not.
benchmarks/**/runs/
benchmarks/**/models/
benchmarks/**/*.log

# Voice audition (tts-engine-audition): the rendered samples and pages of an
# audition file (<name>.audition/ next to it) are local output; published ones
# live on the gh-pages branch, never on main.
*.audition/
